# Optional for starting the app; required to use chat and interview AI features.
GEMINI_API_KEY=

# Supabase project credentials. The anon key is intended for browser use;
# never put the service_role key in this file or the frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
DATABASE_URL=
REPOSEER_RATE_LIMIT_HMAC_KEY=

# For local Docker Compose PostgreSQL only. Use a private, strong value outside local development.
POSTGRES_DB=reposeer
POSTGRES_USER=reposeer
POSTGRES_PASSWORD=reposeer-local-dev
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Browser-visible API URL. This value is embedded in the frontend at image build time.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Comma-separated browser origins allowed by the backend.
REPOSEER_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ZIP upload limits; frontend and backend use the same archive-size value.
REPOSEER_MAX_ARCHIVE_SIZE_MB=25
REPOSEER_MAX_EXTRACTED_SIZE_MB=100
REPOSEER_MAX_ARCHIVE_FILES=2000
REPOSEER_REPORT_RETENTION_DAYS=7
REPOSEER_ANALYSIS_STALE_SECONDS=300
