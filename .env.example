# Optional for starting the app; required to use chat and interview AI features.
GEMINI_API_KEY=

# Browser-visible API URL. This value is embedded in the frontend at image build time.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Comma-separated browser origins allowed by the backend.
REPOSEER_CORS_ORIGINS=http://localhost:3001

# ZIP upload limits; frontend and backend use the same archive-size value.
REPOSEER_MAX_ARCHIVE_SIZE_MB=50
REPOSEER_MAX_EXTRACTED_SIZE_MB=250
REPOSEER_MAX_ARCHIVE_FILES=10000

# In-memory analysis job retention and capacity.
REPOSEER_JOB_TTL_SECONDS=3600
REPOSEER_MAX_JOBS=100
